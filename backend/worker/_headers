# Cache rules for the Workers static-assets layer, matching
# frontend/nginx-frontend.conf in the Docker build. Copied into
# frontend/dist by `npm run worker:build`.

# Everything revalidates by default: index.html, sw.js, SPA deep links,
# public/ files. Otherwise installed PWAs keep last deploy's HTML, which
# points at hashed bundles that no longer exist.
/*
  Cache-Control: no-cache, must-revalidate

# Hashed Vite bundles never change under the same name.
/assets/*
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable
