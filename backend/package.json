{
  "name": "resolvd-backend",
  "version": "1.0.0",
  "type": "commonjs",
  "license": "SEE LICENSE IN LICENSE",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "migrate": "node scripts/migrate.js",
    "worker:build": "npm --prefix ../frontend run build && cp worker/_headers ../frontend/dist/_headers",
    "worker:dev": "npm run worker:build && wrangler dev",
    "worker:deploy": "npm run worker:build && wrangler deploy"
  },
  "dependencies": {
    "@azure/msal-node": "^7.0.1",
    "@googleapis/gmail": "^22.0.2",
    "@noble/hashes": "^2.4.0",
    "argon2": "^0.45.1",
    "connect-pg-simple": "^10.0.0",
    "cors": "^2.8.5",
    "cron-parser": "^5.10.1",
    "cronstrue": "^3.29.0",
    "csv-parse": "^7.0.3",
    "dotenv": "^18.0.5",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.0",
    "express-session": "^1.18.0",
    "google-auth-library": "^11.1.0",
    "marked": "^18.1.0",
    "multer": "^2.4.0",
    "nodemailer": "^10.0.15",
    "otplib": "^13.5.0",
    "pg": "^8.23.1",
    "qrcode": "^1.5.3",
    "sanitize-html": "^2.18.0",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "nodemon": "^3.1.0",
    "vitest": "^5.0.3",
    "wrangler": "^4.152.0"
  }
}
